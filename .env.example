# Environment Variables for TMYTRN LLC Contact Form

# Resend API Configuration
# Get your API key from https://resend.com/api-keys
# Required for contact form to work
RESEND_API_KEY=

# Contact form submissions are delivered to tommy@tmytrn.com.
# They are sent from the verified Resend domain sender-bot.tmytrn.com.
# Reply in the tommy@tmytrn.com inbox goes to the person who submitted the form.
# CONTACT_FROM_EMAIL=Tommy Tran <contact@sender-bot.tmytrn.com>

# Sanity CMS Configuration
# Create a project at https://sanity.io/manage to get these values
# If not set, the site will use fallback static project data

# Your Sanity project ID (required for CMS features)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name (defaults to 'production')
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version (pin to a specific date)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API token with write access (only needed for seed script)
# Never expose this client-side or commit it to the repository
# Create at https://sanity.io/manage → API → Tokens
SANITY_API_WRITE_TOKEN=
